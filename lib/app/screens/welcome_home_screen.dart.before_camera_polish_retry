import 'dart:math' as math;

import 'package:flutter/material.dart';

import '../services/onboarding_milestone_service.dart';
import 'home_screen.dart';

enum _ArrivalPhase { loading, welcome, camera, milestone, exploring }

class WelcomeHomeScreen extends StatefulWidget {
  const WelcomeHomeScreen({super.key});

  @override
  State<WelcomeHomeScreen> createState() => _WelcomeHomeScreenState();
}

class _WelcomeHomeScreenState extends State<WelcomeHomeScreen>
    with SingleTickerProviderStateMixin {
  static const double _artWidth = 1536;
  static const double _artHeight = 1024;

  // Centre of the existing door hotspot.
  static const double _doorCenterX = 0.475 + (0.105 / 2);
  static const double _doorCenterY = 0.44 + (0.30 / 2);

  // Cinematic focal point.
  // Deliberately separate from the interactive door hotspot.
  // This aims the camera toward the body of the cottage rather
  // than pulling the composition toward the gate / lower doorway.
  static const double _houseFocusX = 0.56;
  static const double _houseFocusY = 0.43;

  late final AnimationController _cameraController;

  final TransformationController _explorationController =
      TransformationController();

  _ArrivalPhase _phase = _ArrivalPhase.loading;

  bool _welcomeVisible = false;
  bool _tapPromptVisible = false;
  bool _milestoneVisible = false;

  bool _explorationPositionPending = true;

  @override
  void initState() {
    super.initState();

    _cameraController = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 3400),
    );

    _loadArrivalState();
  }

  @override
  void dispose() {
    _cameraController.dispose();
    _explorationController.dispose();
    super.dispose();
  }

  Future<void> _loadArrivalState() async {
    // DEVELOPMENT REPLAY:
    // Reset Chapter 1 while we tune the opening cinematic.
    await OnboardingMilestoneService.resetForDevelopment();

    final arrivalSeen = await OnboardingMilestoneService.has(
      OnboardingMilestoneService.arrivalSeen,
    );

    if (!mounted) {
      return;
    }

    if (arrivalSeen) {
      setState(() {
        _phase = _ArrivalPhase.exploring;
        _explorationPositionPending = true;
      });
      return;
    }

    setState(() {
      _phase = _ArrivalPhase.welcome;
      _welcomeVisible = true;
    });

    await Future<void>.delayed(const Duration(milliseconds: 1100));

    if (!mounted || _phase != _ArrivalPhase.welcome) {
      return;
    }

    setState(() {
      _tapPromptVisible = true;
    });
  }

  Future<void> _beginArrival() async {
    if (_phase != _ArrivalPhase.welcome) {
      return;
    }

    setState(() {
      _welcomeVisible = false;
      _tapPromptVisible = false;
    });

    await Future<void>.delayed(const Duration(milliseconds: 500));

    if (!mounted) {
      return;
    }

    setState(() {
      _phase = _ArrivalPhase.camera;
    });

    await _cameraController.forward(from: 0);

    if (!mounted) {
      return;
    }

    // The camera arriving at the cottage completes Milestone 1.
    await OnboardingMilestoneService.complete(
      OnboardingMilestoneService.arrivalSeen,
    );

    if (!mounted) {
      return;
    }

    setState(() {
      _phase = _ArrivalPhase.milestone;
      _milestoneVisible = true;
    });

    await Future<void>.delayed(const Duration(milliseconds: 2100));

    if (!mounted) {
      return;
    }

    setState(() {
      _milestoneVisible = false;
    });

    await Future<void>.delayed(const Duration(milliseconds: 1000));

    if (!mounted) {
      return;
    }

    setState(() {
      _phase = _ArrivalPhase.exploring;
      _explorationPositionPending = true;
    });
  }

  Future<void> _goHome() async {
    if (_phase != _ArrivalPhase.exploring) {
      return;
    }

    await OnboardingMilestoneService.complete(
      OnboardingMilestoneService.enteredHome,
    );

    if (!mounted) {
      return;
    }

    Navigator.of(context).pushReplacement(
      MaterialPageRoute<void>(builder: (_) => const HomeScreen()),
    );
  }

  Widget _buildExterior({
    required double width,
    required double height,
    required bool doorEnabled,
  }) {
    return SizedBox(
      width: width,
      height: height,
      child: Stack(
        fit: StackFit.expand,
        children: [
          Image.asset(
            'assets/images/inkdframes_home_exterior_v1.png',
            fit: BoxFit.cover,
            alignment: Alignment.center,
          ),

          // Invisible interactive area over the cottage door.
          Positioned(
            left: width * 0.475,
            top: height * 0.44,
            width: width * 0.105,
            height: height * 0.30,
            child: Semantics(
              button: true,
              label: 'Go home',
              child: GestureDetector(
                behavior: HitTestBehavior.opaque,
                onTap: doorEnabled ? _goHome : null,
                child: const SizedBox.expand(),
              ),
            ),
          ),
        ],
      ),
    );
  }

  double _clampCameraOffset(
    double desired,
    double viewportExtent,
    double contentExtent,
  ) {
    final minimum = math.min(0.0, viewportExtent - contentExtent);
    return desired.clamp(minimum, 0.0).toDouble();
  }

  Matrix4 _finalExteriorTransform({required Size viewport}) {
    // The playable exterior is a fit-to-height 3:2 world.
    //
    // This deliberately prioritises seeing the authored environment:
    // WELCOME HOME, cottage, garden, gate and surrounding landscape.
    final scale = viewport.height / _artHeight;

    final worldWidth = _artWidth * scale;
    final worldHeight = _artHeight * scale;

    // Centre the complete environment when it fits horizontally.
    //
    // If the artwork is wider than the viewport, position it so the
    // cottage remains prominent while retaining as much of the authored
    // left-hand storytelling as possible.
    double x;

    if (worldWidth <= viewport.width) {
      x = (viewport.width - worldWidth) / 2;
    } else {
      final desiredX =
          (viewport.width * 0.54) - (_artWidth * _houseFocusX * scale);

      final minimumX = viewport.width - worldWidth;

      x = desiredX.clamp(minimumX, 0.0).toDouble();
    }

    final y = (viewport.height - worldHeight) / 2;

    return Matrix4.identity()
      ..translate(x, y)
      ..scale(scale);
  }

  Matrix4 _cinematicTransform({
    required Size viewport,
    required double progress,
  }) {
    // --------------------------------------------------------
    // DESTINATION
    //
    // The cinematic ends at EXACTLY the playable exterior.
    // --------------------------------------------------------
    final finalMatrix = _finalExteriorTransform(viewport: viewport);

    final finalScale = finalMatrix.getMaxScaleOnAxis();
    final finalTranslation = finalMatrix.getTranslation();

    final endX = finalTranslation.x;
    final endY = finalTranslation.y;

    // --------------------------------------------------------
    // OPENING
    //
    // Begin 12% wider than the playable view.
    //
    // Because this is an establishing shot, the opening should
    // reveal the environment rather than immediately crowd the house.
    // --------------------------------------------------------
    final startScale = finalScale * 0.88;

    final startWidth = _artWidth * startScale;
    final startHeight = _artHeight * startScale;

    final startX = (viewport.width - startWidth) / 2;
    final startY = (viewport.height - startHeight) / 2;

    final curved = Curves.easeInOutCubic.transform(progress);

    final scale = Tween<double>(
      begin: startScale,
      end: finalScale,
    ).transform(curved);

    final x = Tween<double>(begin: startX, end: endX).transform(curved);

    final y = Tween<double>(begin: startY, end: endY).transform(curved);

    return Matrix4.identity()
      ..translate(x, y)
      ..scale(scale);
  }

  Widget _buildExploration(BoxConstraints constraints) {
    final viewport = Size(constraints.maxWidth, constraints.maxHeight);

    // Apply the final cinematic composition BEFORE the InteractiveViewer
    // is rendered. There is no post-frame camera correction.
    if (_explorationPositionPending) {
      _explorationPositionPending = false;

      _explorationController.value = _finalExteriorTransform(
        viewport: viewport,
      );
    }

    return InteractiveViewer(
      transformationController: _explorationController,
      constrained: false,
      panEnabled: true,
      scaleEnabled: false,
      boundaryMargin: const EdgeInsets.all(400),
      clipBehavior: Clip.hardEdge,
      alignment: Alignment.topLeft,
      child: _buildExterior(
        width: _artWidth,
        height: _artHeight,
        doorEnabled: true,
      ),
    );
  }

  Widget _buildCinematicExterior(BoxConstraints constraints) {
    final viewport = Size(constraints.maxWidth, constraints.maxHeight);

    return ClipRect(
      child: AnimatedBuilder(
        animation: _cameraController,
        builder: (context, child) {
          final progress = _phase == _ArrivalPhase.welcome
              ? 0.0
              : _phase == _ArrivalPhase.milestone
              ? 1.0
              : _cameraController.value;

          return Transform(
            transform: _cinematicTransform(
              viewport: viewport,
              progress: progress,
            ),
            alignment: Alignment.topLeft,
            child: child,
          );
        },
        child: _buildExterior(
          width: _artWidth,
          height: _artHeight,
          doorEnabled: false,
        ),
      ),
    );
  }

  Widget _buildWelcomeOverlay() {
    return Positioned.fill(
      child: GestureDetector(
        behavior: HitTestBehavior.opaque,
        onTap: _beginArrival,
        child: SafeArea(
          child: Padding(
            padding: const EdgeInsets.symmetric(horizontal: 28, vertical: 32),
            child: Center(
              child: Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  AnimatedOpacity(
                    opacity: _welcomeVisible ? 1 : 0,
                    duration: const Duration(milliseconds: 700),
                    curve: Curves.easeOut,
                    child: const Column(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        Text(
                          'WELCOME HOME',
                          textAlign: TextAlign.center,
                          style: TextStyle(
                            color: Color(0xFFF1E5D0),
                            fontSize: 30,
                            fontWeight: FontWeight.w600,
                            letterSpacing: 3.2,
                            shadows: [
                              Shadow(
                                color: Color(0x66000000),
                                blurRadius: 10,
                                offset: Offset(0, 2),
                              ),
                            ],
                          ),
                        ),
                        SizedBox(height: 14),
                        Text(
                          'It’s been a while.\n'
                          'I wonder what’s changed.',
                          textAlign: TextAlign.center,
                          style: TextStyle(
                            color: Color(0xFFE9DDCA),
                            fontSize: 17,
                            height: 1.55,
                            fontStyle: FontStyle.italic,
                            shadows: [
                              Shadow(
                                color: Color(0x55000000),
                                blurRadius: 8,
                                offset: Offset(0, 2),
                              ),
                            ],
                          ),
                        ),
                      ],
                    ),
                  ),
                  const SizedBox(height: 34),
                  AnimatedOpacity(
                    opacity: _tapPromptVisible ? 0.72 : 0,
                    duration: const Duration(milliseconds: 700),
                    curve: Curves.easeOut,
                    child: const Text(
                      'Tap anywhere to continue',
                      textAlign: TextAlign.center,
                      style: TextStyle(
                        color: Color(0xFFD9CCB8),
                        fontSize: 13,
                        letterSpacing: 0.8,
                        shadows: [
                          Shadow(
                            color: Color(0x44000000),
                            blurRadius: 6,
                            offset: Offset(0, 1),
                          ),
                        ],
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }

  Widget _buildMilestoneOverlay() {
    return Positioned(
      top: 0,
      left: 0,
      right: 0,
      child: SafeArea(
        bottom: false,
        child: IgnorePointer(
          child: AnimatedOpacity(
            opacity: _milestoneVisible ? 1 : 0,
            duration: const Duration(milliseconds: 800),
            curve: Curves.easeInOut,
            child: Padding(
              padding: const EdgeInsets.only(top: 24),
              child: Column(
                children: [
                  const Text(
                    'MILESTONE 1',
                    textAlign: TextAlign.center,
                    style: TextStyle(
                      color: Color(0xFFE8D8B5),
                      fontSize: 12,
                      fontWeight: FontWeight.w600,
                      letterSpacing: 3.2,
                      shadows: [Shadow(color: Colors.black87, blurRadius: 8)],
                    ),
                  ),
                  const SizedBox(height: 7),
                  const Text(
                    'ARRIVED HOME',
                    textAlign: TextAlign.center,
                    style: TextStyle(
                      color: Color(0xFFFFF1D2),
                      fontSize: 22,
                      fontWeight: FontWeight.w700,
                      letterSpacing: 2.2,
                      shadows: [Shadow(color: Colors.black87, blurRadius: 9)],
                    ),
                  ),
                  const SizedBox(height: 10),
                  Container(
                    width: 72,
                    height: 1,
                    color: const Color(0x99FFF1D2),
                  ),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.black,
      body: LayoutBuilder(
        builder: (context, constraints) {
          if (_phase == _ArrivalPhase.loading) {
            return const SizedBox.expand();
          }

          final isExploring = _phase == _ArrivalPhase.exploring;

          return Stack(
            fit: StackFit.expand,
            children: [
              if (isExploring)
                _buildExploration(constraints)
              else
                _buildCinematicExterior(constraints),

              if (_phase == _ArrivalPhase.welcome) _buildWelcomeOverlay(),

              if (_phase == _ArrivalPhase.milestone) _buildMilestoneOverlay(),
            ],
          );
        },
      ),
    );
  }
}
